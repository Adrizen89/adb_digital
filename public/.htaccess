# ADB Digital — configuration Apache (Hostinger)

Options -Indexes

# Pas de redirection automatique vers /dossier/ : la route Vue /projects entre
# en collision avec le dossier d'images public/projects/
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force l'apex : www.adbdigital.fr -> adbdigital.fr (evite le contenu duplique)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Un fichier reel est servi tel quel (assets, images, logo.png, robots.txt...)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Tout le reste part vers l'app Vue (fallback SPA)
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html jamais mis en cache : il reference les assets hashes
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Assets generes par Vite : le hash est dans le nom, cache long
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images : noms stables, cache court pour pouvoir les remplacer
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_filter.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
